# Strapi JWT Secrets - Generate unique values for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_JWT_SECRET=your-super-secret-admin-jwt-key-here
API_TOKEN_SALT=your-secure-api-token-salt-here
JWT_SECRET=your-secure-jwt-secret-here
TRANSFER_TOKEN_SALT=your-secure-transfer-token-salt-here
APP_KEYS=change-me-key1,change-me-key2,change-me-key3
ENCRYPTION_KEY=your-secure-encryption-key-here

# Strapi API Token - Get from Strapi Admin Panel → Settings → API Tokens
# Create a token with READ permissions for your content types
STRAPI_TOKEN=your-strapi-api-token-here
