---
interface Props {
  text: string,
  type?: 'button' | 'submit' | 'reset',
};
  
const { text, type = 'button' } = Astro.props;
---

<button type={type} class="ibm-semibold w-full h-16 bg-white duration-100 ease-in-out hover:bg-black border hover:border-white border-black  text-black hover:text-white disabled:opacity-50 disabled:pointer-events-none" style="box-shadow: 4px 4px 0px rgb(0, 0, 0);">
    {text}
</button>