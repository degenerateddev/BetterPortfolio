---
interface Props {
    text: string;
    variant?: 'ink' | 'accent';
    cursor?: boolean;
}

const { text, variant = 'ink', cursor = false } = Astro.props;
---

<div class:list={['highlight w-fit px-4 py-1 ibm-base', `highlight--${variant}`]}>
	<span class="text-base md:text-lg ibm-base">{text}{cursor && <span class="blink" aria-hidden="true">_</span>}</span>
</div>

<style>
	.highlight {
		border: 2px solid var(--ink);
		box-shadow: var(--shadow-hard);
	}

	.highlight--ink {
		background: var(--ink);
		color: #fff;
		border-color: #fff;
	}

	.highlight--accent {
		background: var(--accent);
		color: var(--ink);
	}
</style>
