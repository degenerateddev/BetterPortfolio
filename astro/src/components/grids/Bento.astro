---
import Astro from "../icons/Astro.astro";

interface props {
  data: Object,
};

const data = Astro.props.data || {};

const getLink = (link: string) => {
  if (link.startsWith("http://") || link.startsWith("https://")) {
    return link;
  }

  // ensure base path is correct (even ports for local development)
  return `http://localhost:3000${link}`;
};
---

{Object.entries(data).length > 0 && (
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-2 md:gap-x-5 gap-y-2 md:gap-y-0">
    <div class="border border-black md:row-span-2 retro-shadow">
      {data[4] ? (
        data[4].link ? (
          <a href={getLink(data[4].link)}>
            <img class="h-full w-full object-fill" src={data[4].src} />
          </a>
        ) : (
          <img class="h-full w-full object-fill" src={data[4].src} />
        )
      ) : (
        <img class="h-full w-full object-fill" src="/img/placeholder.webp" />
      )}
    </div>
    <div class="grid grid-cols-2 grid-rows-2 gap-2 md:gap-5">
      {Object.entries(data).slice(0, 4).map(([key, value]) => (
        <div class="border border-black retro-shadow" key={key}>
          {value.link ? (
            <a href={getLink(value.link)}>
              <img class="h-full w-full object-fill" src={value.src} />
            </a>
          ) : (
            <img class="h-full w-full object-fill" src={value.src} />
          )}
        </div>
      ))}
    </div>
  </div>
)}