---
import Slot from './Slot.astro';

interface Props {
  data: Record<number, { src: string; link?: string; title?: string }>,
  variant?: 'light' | 'dark',
};

const data = Astro.props.data || {};
const variant = Astro.props.variant || 'light';
const entries = Object.entries(data);
---

{entries.length > 0 && (
  <div data-slot-grid class="grid grid-cols-1 md:grid-cols-2 gap-x-2 md:gap-x-5 gap-y-2 md:gap-y-0">
    <div class="md:row-span-2 min-h-[240px]">
      <Slot item={data[4]} index={4} variant={variant} large />
    </div>
    <div class="grid grid-cols-2 grid-rows-2 gap-2 md:gap-5">
      {entries.slice(0, 4).map(([key, value]) => (
        <Slot item={value} index={Number(key)} variant={variant} />
      ))}
    </div>
  </div>
)}
