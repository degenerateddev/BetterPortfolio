---
import type { ContentCube } from '../../lib/types/components';
import { strapiImageUrl, cubeLink } from '../../lib/helpers';
import Equal from './Equal.astro';

interface Props {
  cubes: ContentCube[];
  variant?: 'light' | 'dark';
}

const { cubes, variant } = Astro.props;

const data: Record<number, { src: string; link?: string; title?: string }> = {};

cubes.forEach((cube, index) => {
  data[index] = {
    src: strapiImageUrl(cube.image),
    link: cubeLink(cube),
    title: cube.page?.header?.title || cube.image?.alternativeText,
  };
});
---

<Equal data={data} variant={variant} />
