---
import Slot from './Slot.astro';

interface Props {
  data: Record<number, { src: string; link?: string; title?: string; placeholderLabel?: string }>,
  variant?: 'light' | 'dark',
};

const data = Astro.props.data || {};
const variant = Astro.props.variant || 'light';
---

{Object.entries(data).length > 0 && (
  <div data-slot-grid class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-5">
    {Object.entries(data).map(([key, value]) => (
      <Slot item={value} index={Number(key)} variant={variant} />
    ))}
  </div>
)}
