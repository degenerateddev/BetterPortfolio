---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import DynamicContent from '../../components/DynamicContent.astro';
import IconResolver from '../../components/IconResolver.astro';
import { fetchPageBySlug } from '../../lib/strapi';
import Highlight from '../../components/Highlight.astro';

const { slug } = Astro.params;
const page = await fetchPageBySlug(slug as string);

if (!page) {
    return Astro.rewrite('/404');
}

const { header, content, icons, keywords, category } = page;
const isGame = category === 'games';
---

<Layout title={header.title}>
    <div class="flex flex-col h-full gap-y-10">
        <div class:list={['flex flex-col', isGame ? 'band-dark tex-scan -mt-28 pt-40 pb-16 px-5 md:px-10' : 'text-stone-900']}>
            <p class:list={['hud text-sm relative z-10', isGame ? 'accent' : 'text-[var(--accent-2)]']}>
                {isGame ? 'GAME' : `SIDE QUEST · ${category?.toUpperCase()}`}
            </p>
            <h1 class="ibm-semibold relative z-10" data-glitch={isGame ? '' : undefined}>{header.title}</h1>
            <div class="flex items-center gap-10 relative z-10">
                <Highlight text={header.description} variant={isGame ? 'accent' : 'ink'}></Highlight>
                { header.projectLink && <a href={header.projectLink} aria-label="Open project" class="hover:scale-105 transition-transform duration-100">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width=".5" stroke="currentColor" class="size-12 md:size-28">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                </a>
                }
            </div>
        </div>

        {content && content.length > 0 && (
            <div class="flex flex-col gap-y-10">
                <DynamicContent content={content} />
            </div>
        )}

        {icons && icons.length > 0 && (
            <div class="flex justify-center">
                <section class="w-full space-y-10 min-h-[10vh]">
                    <Section title="LOADOUT">
                        <div class="flex flex-col h-full p-10">
                            <h3 class="font-semibold text-2xl ibm-base">Technologies</h3>
                            <br />
                            <div class="flex gap-10 flex-wrap">
                                {icons.map((icon) => (
                                    <IconResolver iconKey={icon.key} />
                                ))}
                            </div>
                        </div>
                    </Section>
                </section>
            </div>
        )}

        {keywords && keywords.length > 0 && (
            <div class="flex py-5 justify-center">
                <div class="flex flex-wrap gap-2">
                    {keywords.map((kw) => (
                        <Highlight text={kw.keyword} />
                    ))}
                </div>
            </div>
        )}
    </div>
</Layout>