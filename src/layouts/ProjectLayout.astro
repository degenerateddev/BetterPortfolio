---
import Layout from "./Layout.astro";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title}>
    <div class="flex flex-col gap-y-10 px-5 md:px-0">
        <div class="flex py-20 justify-center">
            <section class="w-full space-y-10 flex-shrink-0">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="col-span-1 md:col-span-2 flex flex-col md:mt-10 order-2 md:order-1">
                        <h1>{title}</h1>
                        <p>{description}</p>
                    </div>

                    <div class="flex justify-center items-center order-1 md:order-2">
                        <slot name="show-section" />
                    </div>

                    <div class="flex justify-center items-center ibm-base text-lg order-3">
                        <slot name="tell-section" />
                    </div>
                </div>
            </section>
        </div>
    
        <div class="flex py-10 justify-center">
            <section class="w-full space-y-10">
                <slot name="large-img-section" />
            </section>
        </div>
    
        <div class="flex py-10 justify-center">
            <section class="w-full space-y-10">
                <slot name="bento-section" />
            </section>
        </div>
    
        <div class="flex py-10 justify-center">
            <section class="w-full space-y-10 min-h-[50vh] ibm-base text-lg">
                <slot name="detail-section" />
            </section>
        </div>
    </div>
</Layout>