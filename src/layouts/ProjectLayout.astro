---
import Layout from "./Layout.astro";

interface Props {
    title: string;
    description: string;
    url?: string;
}

const { title, description, url } = Astro.props;
---

<Layout title={title}>
    <div class="flex flex-col gap-y-10 px-5 md:px-0">
        <div class="flex py-20 justify-center">
            <section class="w-full space-y-10 flex-shrink-0">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="col-span-1 md:col-span-2 flex flex-col md:mt-10 order-2 md:order-1">
                        <div class="flex items-center gap-10">
                            <h1>{title}</h1>
                            {
                            url ? <a href={url} class="hover:scale-105 transition-transform duration-100">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width=".5" stroke="currentColor" class="size-12 md:size-28">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                                </svg>
                            </a>
                            : <span></span>
                            }
                        </div>
                        <p>{description}</p>
                    </div>

                    <div class="flex justify-center items-center order-1 md:order-2">
                        <slot name="show-section" />
                    </div>

                    <div class="flex justify-center items-center ibm-base text-lg order-3">
                        <slot name="tell-section" />
                    </div>
                </div>
            </section>
        </div>
    
        <div class="flex py-10 justify-center">
            <section class="w-full space-y-10">
                <slot name="large-img-section" />
            </section>
        </div>
    
        <div class="flex py-10 justify-center">
            <section class="w-full space-y-10">
                <slot name="bento-section" />
            </section>
        </div>
    
        <div class="flex py-10 justify-center">
            <section class="w-full space-y-10 min-h-[50vh] ibm-base text-lg">
                <slot name="detail-section" />
            </section>
        </div>
    </div>
</Layout>