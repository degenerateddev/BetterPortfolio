---
import Layout from "./Layout.astro";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title}>
    <div class="px-5 md:px-20">
        
        <div class="flex flex-col gap-y-10">
            <div class="flex flex-col gap-10 py-10">
                <h1 class="text-9xl">{title}</h1>
                <small class="text-base ibm-base">{description}</small>
            </div>

            <div class="flex py-10 justify-center">
                <section class="w-full space-y-10 flex-shrink-0">
                    <div class="grid grid-cols-2 gap-10">
                        <div class="flex justify-center items-center">
                            <slot name="show-section" />
                        </div>
                        <div class="flex justify-center items-center ibm-base text-lg">
                            <slot name="tell-section" />
                        </div>
                    </div>
                </section>
            </div>
        
            <div class="flex py-10 justify-center">
                <section class="w-full space-y-10">
                    <slot name="large-img-section" />
                </section>
            </div>
        
            <div class="flex py-10 justify-center">
                <section class="w-full space-y-10">
                    <slot name="bento-section" />
                </section>
            </div>
        
            <div class="flex py-10 justify-center">
                <section class="w-full space-y-10 min-h-[50vh] ibm-base text-lg">
                    <slot name="detail-section" />
                </section>
            </div>
        </div>
    </div>
</Layout>