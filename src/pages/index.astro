---
import Layout from '../layouts/Layout.astro';
import KeyWords from '../components/KeyWords.vue';
import { PROJECTS } from '../lib';
import Section from '../components/Section.astro';
import Socials from '../components/Socials.astro';
import Bento from '../components/grids/Bento.astro';
import Button from '../components/Button.astro';

const keyWords = () => {
    const keyWords = [];

    PROJECTS.forEach(project => {
        project.keyWords.forEach(keyWord => {
            keyWords.push(keyWord);
        });
    });

    const keyWordsCount = keyWords.reduce((acc, keyWord) => {
        acc[keyWord] = (acc[keyWord] || 0) + 1;
        return acc;
    }, {});

    const keyWordsCountSorted = keyWordsCount;

    return keyWordsCountSorted;
};

const keyWordsCount = keyWords();
---

<Layout title="Tim Arnold">
    <main class="px-5 md:px-20">
        
        <div class="flex flex-col gap-y-96">
            <section id="about" class="min-h-screen space-y-10 md:space-y-52">
                <h1 class="text-8xl md:text-[225px] leading-none md:leading-[225px] text-shadow-md">
                    HI!
                    <br />
                    I'M TIM
                </h1>
                <small class="text-base md:text-lg ibm-base">Programmer, Designer, Writer</small>
    
                <Section>
                    <div class="flex flex-col md:flex-row items-center gap-10">
                        <div class="flex justify-center min-h-[20vh] w-full md:w-fit md:min-w-fit md:justify-start">
                            <img src="/img/me.webp" class="object-fill w-full md:w-auto md:h-full md:object-cover" />
                        </div>
                        <div class="p-0 md:p-10">
                            <p class="flex-grow ibm-base">
                                I'm a <b>programmer</b> and <b>designer</b> from Germany. 
                                My main focus is <b>web & game development</b> and design but I also have experience in cybersecurity and I'm a fiction writer.
                                Currently I'm studying at the Technical University of Applied Sciences in Augsburg.
                            </p>
                        </div>
                    </div>
                </Section>
    
                <!-- <div class="container mx-auto">
                    <KeyWords keyWords={keyWordsCount} />
                </div> -->
            </section>
    
            <section id="programming" class="min-h-screen space-y-10">
                <h2 class="text-6xl md:text-9xl">Programming</h2>
    
                <Bento data={{
                    0: { src: "/img/cubes/clockwork.webp", link: "/project/clockwork" },
                    1: { src: "/img/cubes/docknote.webp", link: "/project/docknote" },
                    2: { src: "/img/cubes/tiptalk.webp", link: "/project/tiptalk" },
                    3: { src: "/img/cubes/daniela.webp", link: "/project/daniela" },
                    4: { src: "/img/cubes/devotee.webp", link: "/project/devotee" }
                }}></Bento>
            </section>
    
            <section id="design" class="min-h-screen space-y-10">
                <h2 class="text-6xl md:text-9xl">Design</h2>
    
                <Bento data={{
                    0: { src: "/img/cubes/smartnapf.webp", link: "/project/smart-napf" },
                    1: { src: "/img/cubes/degeneracy.webp", link: "/project/degeneracy" },
                    2: { src: "/img/cubes/cookster.webp", link: "/project/cookster" },
                    3: { src: "/img/cubes/sinnerslair.webp", link: "/project/sinners-lair" },
                    4: { src: "/img/cubes/echo.webp", link: "/project/echo-inator" }
                }}></Bento>
            </section>
    
            <section id="writing" class="min-h-screen space-y-10">
                <h2 class="text-6xl md:text-9xl">Writing</h2>
    
                <Bento data={{
                    0: { src: "/img/cubes/s1.webp", link: "https://www.story.one/en/story/die-letzte-entscheidung-64475d90aa25e/" },
                    1: { src: "/img/cubes/s2.webp", link: "https://www.story.one/en/story/der-mann-im-limbus-64475d90edaeb/" },
                    2: { src: "/img/cubes/s3.webp", link: "https://www.story.one/en/story/menschenschmied-64475d912ba6c/" },
                    3: { src: "/img/cubes/s4.webp", link: "https://www.story.one/en/story/denn-ordnung-ist-uns-wichtig-64475d965f3ac/" },
                    4: { src: "/img/cubes/book.webp", link: "/project/book" }
                }}></Bento>
            </section>
    
            <section id="contact" class="min-h-screen space-y-10">
                <div class="flex justify-center md:justify-start items-baseline">
                    <h2 class="text-7xl md:text-9xl">Contact</h2>
                </div>
                
                <div class="flex justify-start">
                    <Socials />
                </div>
    
                <form method="POST">
                    <div class="flex flex-col gap-10">
                        <div class="flex gap-10">
                            <input type="text" placeholder="Full name" class="focus:outline-none w-full border border-black p-5 text-black text-lg ibm-base" style="box-shadow: 4px 4px 0px rgb(0, 0, 0);" />
                            <input type="email" placeholder="E-Mail" class="focus:outline-none w-full border border-black p-5 text-black text-lg ibm-base" style="box-shadow: 4px 4px 0px rgb(0, 0, 0);" />
                        </div>
                        <textarea placeholder="Request" class="focus:outline-none w-full h-64 border border-black p-5 text-black text-lg ibm-base" style="box-shadow: 4px 4px 0px rgb(0, 0, 0);"></textarea>
                        <Button text="Submit" />
                    </div>
                </form>
            </section>
        </div>

        <script>
            document.addEventListener(
                "astro:page-load",
                () => {
                    const element = document.querySelector('[type="checkbox"]');
                    element?.addEventListener("change", () => {
                        gsap.to(".box", { x: 100 });
                    })
                },
                { once: false }
            )
        </script>
    </main>
</Layout>