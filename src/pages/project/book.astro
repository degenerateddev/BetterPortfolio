---
import Section from "../../components/Section.astro";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

const project = {
    name: "Abgründe der Melancholie",
    description: "A collection of dark short stories written by me, combined within a book."
}
---

<ProjectLayout description={project.description} title={project.name}>
    <Section slot="show-section">
        <img class="mx-auto" src="/img/cubes/clockwork.webp" />
    </Section>

    <Section slot="tell-section">
        <div class="p-10">
            <p>
                For the 2022 Young Storyteller awards, I wrote a collection of short stories on the website “story.one”.
            <p>
            <br>
                Story.one is a website specifically designed for writing and publishing short stories with a max amount of 2500 characters.
            <p>
            <br>
                “Abgründe der Melancholie” consists of a few selected stories of mine. It contains around 70 pages and 14 stories in total.
            <p>
            <br>  
                It’s also possible to read my stories (including those from the book) on my public story.one profile.
            </p>
        </div>
    </Section>
</ProjectLayout>