---
import Bento from "../../components/grids/Bento.astro";
import Section from "../../components/Section.astro";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import Django from "../../components/icons/Django.astro";
import SvelteKit from "../../components/icons/SvelteKit.astro";
import AWS from "../../components/icons/AWS.astro";

const project = {
    name: "DEVOTEE",
    description: "A social media platform for content creators and content montetization we’ve been developing over the course of 3 years."
}
---

<ProjectLayout description={project.description} title={project.name}>
    <Section slot="show-section">
        <img class="mx-auto" src="/img/cubes/devotee.webp" />
    </Section>

    <Section slot="tell-section">
        <div class="p-5 md:p-10">
            <p>
                DEVOTEE is a platform for managing digital and physical content created by our creators.
            <p>
            <br>
                It allows creators to upload their content and monetize it in a few different ways.
            <p>
            <br>
                We offer a subscription model, a pay-per-view model, and a tipping model, depending on the specific situation.
            <p>
            <br>
                In return for providing a secure and anonymous space for these kinds of transactions, we take a small fee of 15% on each transaction through our platform.
            </p>
        </div>
    </Section>

    <div slot="large-img-section">
        <Section>
            <img class="mx-auto h-full object-fill" src="/img/cubes/devotee/large.webp" />
            <p class="text-center py-2">
                DEVOTEE waitlist page for signing up to receive updates about the development.
            </p>
        </Section>
    </div>

    <div slot="bento-section">
        <Bento data={{
            0: { src: "/img/cubes/devotee/1.webp" },
            1: { src: "/img/cubes/devotee/2.webp" },
            2: { src: "/img/cubes/devotee/3.webp" },
            3: { src: "/img/cubes/devotee/4.webp" },
            4: { src: "/img/cubes/devotee/5.webp" }
        }}></Bento>
    </div>

    <Section slot="detail-section">
        <div class="flex flex-col h-full p-10">
            <p>
                DEVOTEE has been an enormous group effort.
            <p>
            <br>
                My partner developed certain parts of the frontend (login & profile pages) and I mainly worked on the other parts of the frontend, the backend and our own admin panel “Valhalla”.
            <p>
            <br>
                The backend consists of multiple different parts that work separated from one another, primarily the “main” part handling basic logic and database actions and the “worker” part that handles media conversion to save storage space on our S3 bucket.
            </p>

            <hr class="my-10">
            <h3 class="font-semibold text-2xl">Technologies</h3>
            <br>
            <div class="flex gap-10">
                <SvelteKit />
                <Django />
                <AWS />
            </div>
        </div>
    </Section>
</ProjectLayout>